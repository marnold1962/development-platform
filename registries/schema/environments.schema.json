{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registries/environments.yaml",
  "type": "object", "additionalProperties": false,
  "required": ["hosts"],
  "properties": {
    "hosts": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "reach", "deploy_root"],
        "properties": {
          "description": {"type": "string"},
          "reach": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ssh"], "additionalProperties": false,
                    "properties": {"ssh": {"type": "string"}, "note": {"type": "string"}}}},
          "deploy_root": {"type": "string", "pattern": "^/"},
          "router_prefix": {"type": "string", "pattern": "^/.*/$"},
          "environments": {"type": "array", "items": {"type": "string", "enum": ["dev", "cert", "prod"]}}
        }
      }
    }
  }
}
