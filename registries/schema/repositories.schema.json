{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registries/repositories.yaml",
  "type": "object", "additionalProperties": false,
  "required": ["repositories"],
  "properties": {
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "github"],
        "properties": {
          "role": {"type": "string", "enum": ["platform", "application"]},
          "github": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
          "identity": {"type": "string", "enum": ["as2", "company"]}
        }
      }
    }
  }
}
